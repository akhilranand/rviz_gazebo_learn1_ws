<?xml version="1.0"?>
<robot name = "first_robot">
	<link name = "base_link">
		<visual>
			<geometry>
				<box size = "2 2 1" />
			</geometry>
			<origin xyz = "0 0 0" rpy = "0 0 0" />

            <material name="light_yellow">
                <color rgba="1.0 1.0 0.5 0.5"/>
            </material>
		</visual>
		<collision>
			<geometry>
				<box size = "2 2 1" />
			</geometry>
		</collision>
		<inertial>
			<origin xyz = "0 0 0" rpy = "0 0 0" />
			<mass value = "5.0" />
			<inertia 
				ixx = "2.0833" ixy = "0.0" ixz="0.0"
				iyy = "2.0833" iyz="0.0"
				izz = "3.3333" />
		</inertial>
	</link>

	<link name = "head_link">
		<visual>
			<geometry>
				<sphere radius = "0.5" />
			</geometry>
		</visual>
			
		<collision>
			<geometry>
				<sphere radius="0.5"/>
			</geometry>
		</collision>

		<inertial>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<mass value="0.5"/>
			<inertia
				ixx="0.05" ixy="0.0" ixz="0.0"
				iyy="0.05" iyz="0.0"
				izz="0.05"/>
		</inertial>




	</link>

	<joint name = "head_joint" type = "fixed">
		<parent link = "base_link" />
		<child link = "head_link" />
		<origin xyz = "0 0 1"  rpy = "0 0 0" />
		
	</joint>

<link name="left_wheel">
    <visual>
        <origin xyz = "0 0 0 " rpy="1.5708 0 0"/>
        <geometry>
            <cylinder radius="0.3" length="0.2"/>
        </geometry>
    </visual>
	<collision>
	<origin xyz = "0 0 0 " rpy="1.5708 0 0"/>
		<geometry>
			<cylinder radius="0.3" length="0.2"/>
		</geometry>
	</collision>
	<inertial>
		<origin xyz = "0 0 0" rpy = "0 0 0" />
		<mass value = "1.0" />
		<inertia 
			ixx="0.0258" ixy="0.0" ixz="0.0"
			iyy="0.045" iyz="0.0"
			izz="0.0258"
		/>
	</inertial>

</link>

<link name = "right_wheel">
	<visual>
		<geometry>
			<cylinder radius = "0.3" length = "0.2" />
		</geometry>
		<origin xyz = "0 0 0" rpy = "1.5708 0 0" />
	</visual>
	<collision>
		<geometry>
			<cylinder radius = "0.3" length = "0.2" />
		</geometry>
		<origin xyz = "0 0 0" rpy = "1.5708 0 0" />
	</collision>
	<inertial>
		<origin xyz = "0 0 0" rpy = "0 0 0" />
		<mass value = "1.0" />
		<inertia 
			ixx="0.0258" ixy="0.0" ixz="0.0"
			iyy="0.045" iyz="0.0"
			izz="0.0258"
		/>
	</inertial>	
	
</link>	

<joint name = "right_wheel_joint" type = "continuous">
	<parent link = "base_link" />
	<child link = "right_wheel" />
	<origin xyz = "0 -1.1 -0.5" rpy = "0 0 0" />
	<axis xyz = "0 1 0" />
</joint>



<joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>

    <origin xyz="0 1.1 -0.5"
            rpy="0 0 0"/>

       <axis xyz="0 1 0"/> 
</joint>






</robot>
